#MainMenu {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    height: 100%;
    background-size: cover;
    background-position: center;
    padding: 40px;
    gap: 30px;
    background-image: url("project://database/Assets/city.png?fileID=2800000&guid=029ae2c15cf924ad8ad63a3b2c2bbb26&type=3#city");
}

.header {
    font-size: 48px;
    unity-font-style: bold;
    color: white;
    margin-bottom: 60px;
    text-shadow: 0 4px 8px rgba(0, 0, 0, 0.45);
    letter-spacing: 2px;
}

.button {
    width: 300px;
    height: 70px;
    background-color: rgba(255, 255, 255, 0.08);
    color: white;
    font-size: 20px;
    unity-font-style: bold;
    unity-text-align: middle-center;
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    margin-top: 20px;
    margin-bottom: 40px;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25);
    backdrop-filter: ;
    transition: background-color 250ms ease, transform 150ms ease, box-shadow 200ms ease;
}

.button:hover {
    background-color: rgba(255, 255, 255, 0.15);
    transform: ;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
}

.button:active {
    background-color: rgba(255, 255, 255, 0.25);
    transform: ;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.25);
}

.input-field {
    width: 300px;
    height: 56px;
    background-color: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 17px;
    unity-font-style: normal;
    margin-top: 24px;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
    backdrop-filter: ;
    transition: all 200ms ease;
    unity-text-align: middle-left;
    -unity-overflow-clip-box: padding-box;
}

.input-field:focus {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgb(128, 191, 255);
    box-shadow: 0 0 0 3px rgba(127, 179, 255, 0.25), 0 0 16px rgba(127, 179, 255, 0.2);
    transform: ;
}
